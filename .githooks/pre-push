#!/bin/sh
#
# Contrôle avant poussée.
#
# Les invariants de rendu ne tournent pas en CI — la base n'y est pas
# disponible. S'ils ne tournent nulle part, ils ne protègent de rien : c'est
# donc ici qu'ils s'exécutent, avec un serveur local qui a les identifiants.
#
# Installation : git config core.hooksPath .githooks
#
# Contournement, pour une poussée qui ne touche pas l'interface :
#   SAUTER_RENDU=1 git push
set -e

echo "→ typecheck"
bun run typecheck
echo "→ tests de règles"
bun run test
echo "→ invariants du catalogue"
bun run invariants
echo "→ invariants du design"
bun run invariants:design

if [ -n "$SAUTER_RENDU" ]; then
  echo "→ invariants de rendu : sautés (SAUTER_RENDU)"
  exit 0
fi

if [ ! -f .env.local ]; then
  echo "→ invariants de rendu : sautés (.env.local absent, le serveur ne démarrerait pas)"
  exit 0
fi

#
# REPRISE UNIQUE, ET C'EST UN PANSEMENT.
#
# Les invariants tournent contre `vite dev`, qui compile à la demande : sous
# charge, un test expire sans qu'aucun défaut n'existe. Un hook qui échoue au
# hasard finit par être contourné — `--no-verify` devient un réflexe, et le
# garde-fou ne protège plus rien. C'est le mécanisme documenté au §8.
#
# Une seule reprise, jamais deux : au-delà, on ne distingue plus une
# intermittence d'un défaut qui n'échoue qu'une fois sur trois.
#
# LE VRAI CORRECTIF est de servir un build. Il est décrit dans
# `playwright.config.ts` et bloqué côté hébergement — voir le préréglage Nitro.
echo "→ invariants de rendu"
if ! bun run invariants:rendu; then
  echo ""
  echo "→ échec — reprise unique (intermittence du serveur de développement)"
  bun run invariants:rendu
fi
